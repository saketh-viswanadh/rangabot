{
  "name": "rangabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/saketh-viswanadh/rangabot.git"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "clean:generated": "node --experimental-strip-types scripts/clean-generated.ts",
    "check": "npm run clean:generated && npm test && npm run lint && npm run typecheck && npm run build && npm run privacy:check",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "privacy:check": "node --experimental-strip-types scripts/check-private-files.ts",
    "knowledge:init": "node --experimental-strip-types scripts/knowledge-cli.ts init",
    "knowledge:status": "node --experimental-strip-types scripts/knowledge-cli.ts status",
    "knowledge:doctor": "node --experimental-strip-types scripts/knowledge-cli.ts doctor",
    "knowledge:validate": "node --experimental-strip-types scripts/knowledge-cli.ts validate",
    "knowledge:backup": "node --experimental-strip-types scripts/knowledge-cli.ts backup",
    "knowledge:rollback": "node --experimental-strip-types scripts/knowledge-cli.ts rollback",
    "knowledge:ingest": "node --experimental-strip-types scripts/ingest-knowledge.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
