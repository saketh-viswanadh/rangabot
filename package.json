{
  "name": "rangabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/saketh-viswanadh/rangabot.git"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/start-dev.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "clean:generated": "node --experimental-strip-types scripts/clean-generated.ts",
    "check": "npm run clean:generated && npm run charter:check && npm run mastery:evidence && npm run mastery:check && npm run conversation:evaluate:validate && npm run conversation:evaluate:memory && npm test && npm run lint && npm run typecheck && npm run build && npm run privacy:check",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "privacy:check": "node --experimental-strip-types scripts/check-private-files.ts",
    "charter:generate": "node --experimental-strip-types scripts/generate-charter.ts",
    "charter:check": "node --experimental-strip-types scripts/generate-charter.ts --check",
    "mastery:generate": "node --experimental-strip-types scripts/generate-mastery-tree.ts",
    "mastery:check": "node --experimental-strip-types scripts/generate-mastery-tree.ts --check",
    "mastery:evidence": "node --experimental-strip-types scripts/check-mastery-evidence.ts",
    "mastery:governance": "node --experimental-strip-types scripts/check-mastery-governance.ts",
    "knowledge:init": "node --experimental-strip-types scripts/knowledge-cli.ts init",
    "knowledge:status": "node --experimental-strip-types scripts/knowledge-cli.ts status",
    "knowledge:doctor": "node --experimental-strip-types scripts/knowledge-cli.ts doctor",
    "knowledge:vector-index": "node --experimental-strip-types scripts/knowledge-cli.ts vector-index",
    "knowledge:evaluate": "node --experimental-strip-types scripts/evaluate-knowledge.ts",
    "knowledge:evaluate:answers": "node --experimental-strip-types scripts/evaluate-knowledge-answers.ts",
    "conversation:evaluate": "node --experimental-strip-types scripts/evaluate-conversation.ts",
    "conversation:evaluate:baseline": "node --experimental-strip-types scripts/evaluate-conversation.ts --baseline",
    "conversation:evaluate:validate": "node --experimental-strip-types scripts/evaluate-conversation.ts --validate-only",
    "conversation:evaluate:memory": "node --experimental-strip-types scripts/evaluate-memory-selection.ts",
    "conversation:evaluate:matrix": "node --experimental-strip-types scripts/evaluate-model-matrix.ts",
    "conversation:evaluate:sql": "node --experimental-strip-types scripts/evaluate-conversational-sql.ts",
    "conversation:evaluate:sql:holdout": "node --experimental-strip-types scripts/evaluate-analytical-holdout.ts",
    "conversation:evaluate:sql:holdout:v2": "node --experimental-strip-types scripts/evaluate-analytical-holdout-v2.ts",
    "conversation:evaluate:sql:holdout:v3": "node --experimental-strip-types scripts/evaluate-analytical-holdout-v3.ts",
    "conversation:evaluate:sql:holdout:v4": "node --experimental-strip-types scripts/evaluate-analytical-holdout-v4.ts",
    "conversation:evaluate:sql:holdout:v5": "node --experimental-strip-types scripts/evaluate-analytical-holdout-v5.ts",
    "conversation:evaluate:sql:pack": "node --experimental-strip-types scripts/evaluate-analytical-holdout-v4.ts --expert-pack",
    "conversation:evaluate:sql:roles": "node --experimental-strip-types scripts/evaluate-analytical-role-development.ts",
    "conversation:evaluate:sql:narration": "node --experimental-strip-types scripts/evaluate-analytical-narration.ts",
    "conversation:reviewer:qualify": "node --experimental-strip-types scripts/qualify-conversation-reviewer.ts",
    "knowledge:validate": "node --experimental-strip-types scripts/knowledge-cli.ts validate",
    "knowledge:backup": "node --experimental-strip-types scripts/knowledge-cli.ts backup",
    "knowledge:rollback": "node --experimental-strip-types scripts/knowledge-cli.ts rollback",
    "knowledge:ingest": "node --experimental-strip-types scripts/ingest-knowledge.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
